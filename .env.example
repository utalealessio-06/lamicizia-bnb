# Copiare in Netlify > Site configuration > Environment variables (non nel codice).

# Stripe (account intestato alla struttura). Per i test usare le chiavi sk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Developers > Webhooks > endpoint https://<dominio>/api/stripe-webhook
# eventi: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_...

# Percentuale di caparra (0 = solo pagamento intero)
DEPOSIT_PERCENT=30

# Pannello /admin di Maddalena (almeno 8 caratteri, meglio una frase lunga)
ADMIN_PASSWORD=

# Email automatiche (resend.com, dominio verificato)
RESEND_API_KEY=re_...
EMAIL_FROM="B&B L'Amicizia <prenotazioni@bblamicizia.it>"
OWNER_EMAIL=

# Recensioni Google (Places API "New")
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
